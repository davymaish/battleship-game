{
  "name": "battleship-game-v2",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm --filter @battleship/web build",
    "dev": "pnpm --filter @battleship/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify:v1": "node tests/run-tests.js",
    "verify:v2": "pnpm typecheck && pnpm test && pnpm build",
    "release:verify": "pnpm verify:v2 && pnpm verify:v1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
